# ==============================================================================
# WuzPay Backend Environment Configuration
# ==============================================================================

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/wuzpay?appName=WuzPay

# Server Configuration
PORT=5000

# AI Features / Agent Orchestration (Groq - OpenAI Compatible)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini (Optional / Legacy fallback, still used for receipt scan if needed)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent

# Receipt Vision (Groq Vision / OpenAI Compatible)
OPENAI_API_KEY=gsk_your_groq_api_key_here
OPENAI_API_URL=https://api.groq.com/openai/v1

# JWT Authentication
JWT_SECRET=your_jwt_super_secret_key_here
